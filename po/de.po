msgid "Fit the window (Ctrl+0)"
msgstr "An Fenster anpassen (Strg+0)"

#: usr/lib/xl-screenshot/xlannotate/window.py:438
msgid ""
"Drag the area to keep. Adjust it with the handles, or drag it to move it."
msgstr ""
"Ziehen Sie den Bereich auf, der bleiben soll. Passen Sie ihn mit den Griffen "
