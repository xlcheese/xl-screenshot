#. Translators: the start of a new annotated image's file name (date and time
#. follow)
#: usr/lib/xl-screenshot/xlannotate/window.py:884
msgid "Annotated"
msgstr "Annotée"

#: usr/lib/xl-screenshot/xlannotate/window.py:940
msgid "Keep your annotations?"
msgstr "Garder vos annotations ?"

#: usr/lib/xl-screenshot/xlannotate/window.py:941
msgid "Keep updates the screenshot. Discard throws these changes away."
msgstr "Garder met à jour la capture. Abandonner supprime ces modifications."

#: usr/lib/xl-screenshot/xlannotate/window.py:942
msgid "_Discard"
msgstr "A_bandonner"

#: usr/lib/xl-screenshot/xlannotate/window.py:943
