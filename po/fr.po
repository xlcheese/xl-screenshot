#: usr/lib/xl-screenshot/xlannotate/window.py:33
msgid ""
"Select: click a mark to move it (Shift: straight across or down), reshape it "
"with its handles, change its colours and style, or press Delete. Double-click"
" text to edit it."
msgstr ""
"Sélection : cliquez sur une marque pour la déplacer (Maj : uniquement à "
"l’horizontale ou à la verticale), modifiez sa forme avec ses poignées, "
"changez ses couleurs et son style, ou appuyez sur Suppr. Double-cliquez sur "
"un texte pour le modifier."

#: usr/lib/xl-screenshot/xlannotate/window.py:36
msgid "Arrow (hold Shift for 45° angles)"
msgstr "Flèche (maintenez Maj pour des angles de 45°)"

#: usr/lib/xl-screenshot/xlannotate/window.py:38
msgid "Line (hold Shift for 45° angles)"
msgstr "Ligne (maintenez Maj pour des angles de 45°)"

#: usr/lib/xl-screenshot/xlannotate/window.py:40
msgid ""
"Freehand: draw with the mouse. Rough lines, arrows, circles and boxes are "
"tidied into clean shapes (you can keep your drawing, or turn this off in the "
"menu)."
msgstr ""
"Main levée : dessinez à la souris. Les lignes, flèches, cercles et cadres "
"approximatifs sont transformés en formes nettes (vous pouvez garder votre "
"dessin, ou désactiver cette option dans le menu)."

#: usr/lib/xl-screenshot/xlannotate/window.py:43
msgid "Rectangle (hold Shift for a square)"
msgstr "Rectangle (maintenez Maj pour un carré)"

#: usr/lib/xl-screenshot/xlannotate/window.py:45
msgid "Ellipse (hold Shift for a circle)"
msgstr "Ellipse (maintenez Maj pour un cercle)"

#: usr/lib/xl-screenshot/xlannotate/window.py:47
msgid "Highlighter: drag a box over text to mark it"
msgstr "Surligneur : tracez un cadre sur du texte pour le marquer"

#: usr/lib/xl-screenshot/xlannotate/window.py:49
msgid "Text: click where it goes. A fill colour puts a box behind it."
msgstr ""
"Texte : cliquez à l’endroit voulu. Une couleur de remplissage place un cadre "
"derrière."

#: usr/lib/xl-screenshot/xlannotate/window.py:51
msgid "Numbered steps: each click adds the next number"
msgstr "Étapes numérotées : chaque clic ajoute le numéro suivant"

#: usr/lib/xl-screenshot/xlannotate/window.py:53
msgid "Pixelate: drag a box over anything private (passwords, emails, names)"
msgstr ""
"Pixelliser : tracez un cadre sur tout ce qui est privé (mots de passe, "
"e-mails, noms)"

#: usr/lib/xl-screenshot/xlannotate/window.py:55
msgid ""
"Loupe: click to magnify a spot. Drag the green handle round the ring to zoom "
"more or less, and the white one to change its size."
msgstr ""
"Loupe : cliquez pour agrandir un endroit. Faites glisser la poignée verte "
"autour de l’anneau pour zoomer plus ou moins, et la blanche pour changer sa "
"taille."

#: usr/lib/xl-screenshot/xlannotate/window.py:58
msgid "Crop: drag the area to keep"
msgstr "Rogner : tracez la zone à conserver"

#: usr/lib/xl-screenshot/xlannotate/window.py:63
msgid "Line thickness"
msgstr "Épaisseur du trait"

#: usr/lib/xl-screenshot/xlannotate/window.py:64
msgid "Text size"
msgstr "Taille du texte"

#: usr/lib/xl-screenshot/xlannotate/window.py:65
msgid "Size of the numbered circles"
msgstr "Taille des cercles numérotés"

#: usr/lib/xl-screenshot/xlannotate/window.py:66
msgid "Block size (use bigger blocks to hide text)"
msgstr "Taille des blocs (de plus gros blocs cachent mieux le texte)"

#: usr/lib/xl-screenshot/xlannotate/window.py:67
msgid "Size of the lens"
msgstr "Taille de la lentille"

#: usr/lib/xl-screenshot/xlannotate/window.py:70
msgid "Solid line"
msgstr "Trait plein"

#: usr/lib/xl-screenshot/xlannotate/window.py:70
msgid "Dashed line"
msgstr "Trait tireté"

#: usr/lib/xl-screenshot/xlannotate/window.py:70
msgid "Dotted line"
msgstr "Trait pointillé"

#: usr/lib/xl-screenshot/xlannotate/window.py:168
msgid ""
"Line colour (front) and fill colour (back).\n"
"Click one, then pick a colour below."
msgstr ""
"Couleur du trait (devant) et couleur de remplissage (derrière).\n"
"Cliquez sur l’une, puis choisissez une couleur en dessous."

#: usr/lib/xl-screenshot/xlannotate/window.py:211
#: usr/lib/xl-screenshot/xlannotate/window.py:772
msgid "Untitled"
msgstr "Sans titre"

#: usr/lib/xl-screenshot/xlannotate/window.py:230
msgid "Done"
msgstr "Terminé"

#: usr/lib/xl-screenshot/xlannotate/window.py:232
msgid "Use the annotated image in xl-Screenshot"
msgstr "Utiliser l’image annotée dans xl-Screenshot"

#: usr/lib/xl-screenshot/xlannotate/window.py:236
msgid "Tidy Up Freehand Drawings"
msgstr "Rectifier les dessins à main levée"

#: usr/lib/xl-screenshot/xlannotate/window.py:237
msgid "Turn rough freehand lines, arrows, circles and boxes into clean shapes"
msgstr ""
"Transformer les lignes, flèches, cercles et cadres approximatifs en formes "
"nettes"

#: usr/lib/xl-screenshot/xlannotate/window.py:244
