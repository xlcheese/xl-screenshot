msgstr "Não foi possível abrir a imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:1068
msgid "Open Image"
msgstr "Abrir imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:1070
#: usr/lib/xl-screenshot/xlannotate/window.py:1127
#: usr/lib/xl-screenshot/xlannotate/window.py:1199
#: usr/lib/xl-screenshot/xlannotate/window.py:1204
#: usr/lib/xl-screenshot/xlscreenshot/window.py:851
#: usr/lib/xl-screenshot/xlshared/ui.py:84
msgid "_Cancel"
msgstr "_Cancelar"

#: usr/lib/xl-screenshot/xlannotate/window.py:1070
msgid "_Open"
msgstr "_Abrir"

#: usr/lib/xl-screenshot/xlannotate/window.py:1073
#: usr/lib/xl-screenshot/xlannotate/window.py:1147
msgid "Images"
msgstr "Imagens"

#: usr/lib/xl-screenshot/xlannotate/window.py:1092
msgid "Pasted Image"
msgstr "Imagem colada"

#: usr/lib/xl-screenshot/xlannotate/window.py:1101
#: usr/lib/xl-screenshot/xlscreenshot/window.py:894
msgid "Could not save image"
msgstr "Não foi possível salvar a imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:1125
msgid "Save Annotated Image As"
msgstr "Salvar imagem anotada como"

#: usr/lib/xl-screenshot/xlannotate/window.py:1127
#: usr/lib/xl-screenshot/xlannotate/window.py:1205
#: usr/lib/xl-screenshot/xlscreenshot/window.py:851
msgid "_Save"
msgstr "_Salvar"

#. Translators: the suggested file name for a copy; {name} is the original's name
#: usr/lib/xl-screenshot/xlannotate/window.py:1137
#, python-brace-format
msgid "{name}-annotated"
msgstr "{name}-anotada"

#. Translators: the start of a new annotated image's file name (date and time follow)
#: usr/lib/xl-screenshot/xlannotate/window.py:1141
msgid "Annotated"
msgstr "Anotada"

#: usr/lib/xl-screenshot/xlannotate/window.py:1197
msgid "Keep your annotations?"
msgstr "Manter suas anotações?"

#: usr/lib/xl-screenshot/xlannotate/window.py:1198
msgid "Keep updates the screenshot. Discard throws these changes away."
msgstr ""
"Manter atualiza a captura de tela. Descartar joga essas alterações fora."

#: usr/lib/xl-screenshot/xlannotate/window.py:1199
msgid "_Discard"
msgstr "_Descartar"

#: usr/lib/xl-screenshot/xlannotate/window.py:1200
msgid "_Keep"
msgstr "_Manter"

#: usr/lib/xl-screenshot/xlannotate/window.py:1202
#, python-brace-format
msgid "Save changes to “{name}”?"
msgstr "Salvar as alterações em “{name}”?"

#: usr/lib/xl-screenshot/xlannotate/window.py:1203
msgid "If you don't save, your annotations will be lost."
msgstr "Se você não salvar, suas anotações serão perdidas."

#: usr/lib/xl-screenshot/xlannotate/window.py:1204
msgid "_Don't Save"
msgstr "_Não salvar"

#: usr/lib/xl-screenshot/xlannotate/window.py:1291
msgid ""
"Simple, light markup for images and screenshots: arrows, boxes and text that "
"stay editable until you save."
msgstr ""
"Marcações simples e leves para imagens e capturas de tela: setas, caixas e "
"texto que continuam editáveis até você salvar."

#: usr/lib/xl-screenshot/xlscreenshot/application.py:37
msgid "Start a Selection capture right away"
msgstr "Iniciar uma captura de seleção imediatamente"

#: usr/lib/xl-screenshot/xlscreenshot/application.py:40
msgid "Start with just the tray icon (used when logging in)"
msgstr "Iniciar só com o ícone na bandeja (usado ao entrar na sessão)"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:61
msgid ""
"expected X,Y,W,H with no spaces, e.g. 100,100,400,300 (or in quotes: \"100, "
"100, 400, 300\")"
msgstr ""
"esperado X,Y,L,A sem espaços, ex.: 100,100,400,300 (ou entre aspas: \"100, "
"100, 400, 300\")"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:63
msgid "expected X,Y,W,H, e.g. 100,100,400,300"
msgstr "esperado X,Y,L,A, ex.: 100,100,400,300"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:65
msgid "the width and height must be more than 0"
msgstr "a largura e a altura devem ser maiores que 0"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:81
msgid "expected a window id, e.g. 0x3a00007"
msgstr "esperado um id de janela, ex.: 0x3a00007"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:90
msgid "expected a number from 1 to 100"
msgstr "esperado um número de 1 a 100"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:100
msgid "expected a number of seconds"
msgstr "esperado um número de segundos"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:107
msgid "xl-screenshot [WHAT TO CAPTURE] [OPTIONS] [FILE]"
msgstr "xl-screenshot [O QUE CAPTURAR] [OPÇÕES] [ARQUIVO]"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:108
msgid ""
"Without options, xl-Screenshot opens its window. With any of the options "
"below (except --selection, --tray and --version on their own), it captures, "
"saves and exits, with no window."
msgstr ""
"Sem opções, o xl-Screenshot abre a sua janela. Com qualquer uma das opções "
"abaixo (exceto --selection, --tray e --version sozinhas), ele captura, salva "
"e sai, sem janela."

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:111
msgid ""
"Positions and sizes are in real pixels. Screens are numbered as --list-"
"screens shows. Without a file name, captures go to Pictures/xl-Screenshot. "
"The saved file's path is printed."
msgstr ""
"Posições e tamanhos são em pixels reais. As telas são numeradas como --list-"
"screens mostra. Sem nome de arquivo, as capturas vão para Imagens/xl-"
"Screenshot. O caminho do arquivo salvo é exibido."

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:114
msgid "What to capture (one of)"
msgstr "O que capturar (um destes)"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:116
msgid "every screen (the default)"
msgstr "todas as telas (o padrão)"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:118
msgid "screen N, or without N the one the pointer is on (X11)"
msgstr "a tela N, ou sem N a que está com o ponteiro (X11)"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:120
msgid "a rectangle, e.g. 100,100,400,300"
msgstr "um retângulo, ex.: 100,100,400,300"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:122
msgid "draw the area, as with the Selection button"
msgstr "desenhar a área, como com o botão Seleção"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:124
msgid "pick a window, as with the Window button"
msgstr "escolher uma janela, como com o botão Janela"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:126
msgid "the window that has the focus"
msgstr "a janela que está em foco"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:128
msgid "a window by its X11 id (see xwininfo); X11 only"
msgstr "uma janela pelo seu id do X11 (veja xwininfo); só X11"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:130
msgid "Where it goes"
msgstr "Para onde vai"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:133
#, python-format
msgid ""
"save here; - writes the image to standard output. Takes %%Y, %%m, %%d, %%H, "
"%%M, %%S (see strftime), $w and $h (the image's width and height) and $$ (a "
"$)"
msgstr ""
"salvar aqui; - escreve a imagem na saída padrão. Aceita %%Y, %%m, %%d, %%H, "
"%%M, %%S (veja strftime), $w e $h (a largura e a altura da imagem) e $$ (um "
"$)"

#: usr/lib/xl-screenshot/xlscreenshot/cli.py:137
