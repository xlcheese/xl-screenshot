#: usr/lib/xl-screenshot/xlannotate/window.py:824
msgid "Keep proportions"
msgstr "Manter as proporções"

#: usr/lib/xl-screenshot/xlannotate/window.py:827
msgid "Scale"
msgstr "Escala"

#: usr/lib/xl-screenshot/xlannotate/window.py:843
msgid "Resize"
msgstr "Redimensionar"

#: usr/lib/xl-screenshot/xlannotate/window.py:905
msgid "Rotate or flip the image"
msgstr "Girar ou espelhar a imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:1041
