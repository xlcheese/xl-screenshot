msgstr "Abrir uma imagem (Ctrl+O)"

#: usr/lib/xl-screenshot/xlannotate/window.py:292
msgid "Save (Ctrl+S)"
msgstr "Salvar (Ctrl+S)"

#: usr/lib/xl-screenshot/xlannotate/window.py:294
msgid "Save As… (Shift+Ctrl+S)"
msgstr "Salvar como… (Shift+Ctrl+S)"

#: usr/lib/xl-screenshot/xlannotate/window.py:296
msgid "Copy to Clipboard (Ctrl+C)"
msgstr "Copiar para a área de transferência (Ctrl+C)"

#: usr/lib/xl-screenshot/xlannotate/window.py:300
msgid "Undo (Ctrl+Z)"
msgstr "Desfazer (Ctrl+Z)"

#: usr/lib/xl-screenshot/xlannotate/window.py:302
msgid "Redo (Shift+Ctrl+Z)"
msgstr "Refazer (Shift+Ctrl+Z)"

#: usr/lib/xl-screenshot/xlannotate/window.py:320
msgid "Drop shadow"
msgstr "Sombra"

#: usr/lib/xl-screenshot/xlannotate/window.py:368
msgid "Swap the line and fill colors"
msgstr "Trocar as cores da linha e do preenchimento"

#: usr/lib/xl-screenshot/xlannotate/window.py:384
msgid "No color"
msgstr "Sem cor"

#: usr/lib/xl-screenshot/xlannotate/window.py:395
msgid "Solid color"
msgstr "Cor sólida"

#: usr/lib/xl-screenshot/xlannotate/window.py:397
#, no-python-format, python-brace-format
msgid "Semi-transparent ({percent}% opacity)"
msgstr "Semitransparente ({percent}% de opacidade)"

#. Translators: "Sheer" is a see-through color (the short label beside "Solid")
#: usr/lib/xl-screenshot/xlannotate/window.py:400
msgid "Solid"
msgstr "Sólido"

#: usr/lib/xl-screenshot/xlannotate/window.py:400
