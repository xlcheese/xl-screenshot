msgstr "Borda esquerda, em pixels a partir da esquerda da imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:480
msgid "Top edge, in pixels from the top of the image"
msgstr "Borda superior, em pixels a partir do topo da imagem"

#: usr/lib/xl-screenshot/xlannotate/window.py:481
