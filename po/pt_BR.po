#: usr/lib/xl-screenshot/xlannotate/window.py:33
msgid ""
"Select: click a mark to move it (Shift: straight across or down), reshape it "
"with its handles, change its colors and style, or press Delete. Double-click "
"text to edit it."
msgstr ""
"Selecionar: clique em uma marcação para movê-la (Shift: só na horizontal ou "
"na vertical), mude a forma pelas alças, altere as cores e o estilo, ou "
"pressione Delete. Clique duas vezes em um texto para editá-lo."

#: usr/lib/xl-screenshot/xlannotate/window.py:36
msgid "Arrow (hold Shift for 45° angles)"
msgstr "Seta (segure Shift para ângulos de 45°)"

#: usr/lib/xl-screenshot/xlannotate/window.py:38
msgid "Line (hold Shift for 45° angles)"
msgstr "Linha (segure Shift para ângulos de 45°)"

#: usr/lib/xl-screenshot/xlannotate/window.py:40
msgid ""
"Freehand: draw with the mouse. Rough lines, arrows, circles and boxes are "
"tidied into clean shapes (you can keep your drawing, or turn this off in the "
"menu)."
msgstr ""
"Mão livre: desenhe com o mouse. Linhas, setas, círculos e caixas tortos "
"viram formas limpas (você pode manter seu desenho ou desativar isso no menu)."

#: usr/lib/xl-screenshot/xlannotate/window.py:43
msgid ""
"Ink pen: the line is thicker where you draw slowly and thinner where you "
"draw quickly (with a drawing tablet, it follows the pen's pressure)"
msgstr ""
"Caneta tinteiro: a linha fica mais grossa onde você desenha devagar e mais "
"fina onde desenha rápido (com uma mesa digitalizadora, ela segue a pressão "
"da caneta)"

#: usr/lib/xl-screenshot/xlannotate/window.py:46
msgid "Rectangle (hold Shift for a square)"
msgstr "Retângulo (segure Shift para um quadrado)"

#: usr/lib/xl-screenshot/xlannotate/window.py:48
msgid "Ellipse (hold Shift for a circle)"
msgstr "Elipse (segure Shift para um círculo)"

#: usr/lib/xl-screenshot/xlannotate/window.py:50
msgid "Highlighter: drag a box over text to mark it"
msgstr "Marca-texto: arraste uma caixa sobre o texto para destacá-lo"

#: usr/lib/xl-screenshot/xlannotate/window.py:52
msgid "Text: click where it goes. A fill color puts a box behind it."
msgstr ""
"Texto: clique onde ele vai ficar. Uma cor de preenchimento coloca uma caixa "
"atrás dele."

#: usr/lib/xl-screenshot/xlannotate/window.py:54
msgid "Numbered steps: each click adds the next number"
msgstr "Passos numerados: cada clique adiciona o próximo número"

#: usr/lib/xl-screenshot/xlannotate/window.py:56
msgid "Pixelate: drag a box over anything private (passwords, emails, names)"
msgstr ""
"Pixelizar: arraste uma caixa sobre qualquer coisa privada (senhas, e-mails, "
"nomes)"

#: usr/lib/xl-screenshot/xlannotate/window.py:58
msgid ""
"Loupe: click to magnify a spot. Drag the green handle round the ring to zoom "
"more or less, and the white one to change its size."
msgstr ""
"Lupa: clique para ampliar um ponto. Arraste a alça verde ao redor do anel "
"para ampliar mais ou menos, e a branca para mudar o tamanho."

#: usr/lib/xl-screenshot/xlannotate/window.py:61
msgid "Crop: drag the area to keep"
msgstr "Recortar: arraste a área que deseja manter"

#: usr/lib/xl-screenshot/xlannotate/window.py:67
msgid "Rotate Left"
msgstr "Girar à esquerda"

#: usr/lib/xl-screenshot/xlannotate/window.py:68
msgid "Rotate Right"
msgstr "Girar à direita"

#: usr/lib/xl-screenshot/xlannotate/window.py:69
msgid "Flip Horizontally"
msgstr "Espelhar horizontalmente"

#: usr/lib/xl-screenshot/xlannotate/window.py:70
msgid "Flip Vertically"
msgstr "Espelhar verticalmente"

#: usr/lib/xl-screenshot/xlannotate/window.py:77
msgid "Line thickness"
msgstr "Espessura da linha"

#: usr/lib/xl-screenshot/xlannotate/window.py:78
msgid "Text size"
msgstr "Tamanho do texto"

#: usr/lib/xl-screenshot/xlannotate/window.py:79
msgid "Size of the numbered circles"
msgstr "Tamanho dos círculos numerados"

#: usr/lib/xl-screenshot/xlannotate/window.py:80
msgid "Block size (use bigger blocks to hide text)"
msgstr "Tamanho do bloco (use blocos maiores para esconder texto)"

#: usr/lib/xl-screenshot/xlannotate/window.py:81
msgid "Size of the lens"
msgstr "Tamanho da lente"

#: usr/lib/xl-screenshot/xlannotate/window.py:84
msgid "Solid line"
msgstr "Linha contínua"

#: usr/lib/xl-screenshot/xlannotate/window.py:84
msgid "Dashed line"
msgstr "Linha tracejada"

#: usr/lib/xl-screenshot/xlannotate/window.py:84
msgid "Dotted line"
msgstr "Linha pontilhada"

#: usr/lib/xl-screenshot/xlannotate/window.py:182
msgid ""
"Line color (front) and fill color (back).\n"
"Click one, then pick a color below."
msgstr ""
"Cor da linha (frente) e cor de preenchimento (trás).\n"
"Clique em uma e escolha uma cor abaixo."

#: usr/lib/xl-screenshot/xlannotate/window.py:225
#: usr/lib/xl-screenshot/xlannotate/window.py:1029
msgid "Untitled"
msgstr "Sem título"

#: usr/lib/xl-screenshot/xlannotate/window.py:244
msgid "Done"
msgstr "Concluído"

#: usr/lib/xl-screenshot/xlannotate/window.py:246
msgid "Use the annotated image in xl-Screenshot"
msgstr "Usar a imagem anotada no xl-Screenshot"

#: usr/lib/xl-screenshot/xlannotate/window.py:250
msgid "Tidy Up Freehand Drawings"
msgstr "Arrumar desenhos à mão livre"

#: usr/lib/xl-screenshot/xlannotate/window.py:251
msgid "Turn rough freehand lines, arrows, circles and boxes into clean shapes"
msgstr ""
"Transformar linhas, setas, círculos e caixas à mão livre em formas limpas"

#: usr/lib/xl-screenshot/xlannotate/window.py:258
#: usr/lib/xl-screenshot/xlscreenshot/window.py:164
msgid "About"
msgstr "Sobre"

#: usr/lib/xl-screenshot/xlannotate/window.py:290
