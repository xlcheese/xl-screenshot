#: usr/lib/xl-screenshot/xlannotate/window.py:527
#: usr/lib/xl-screenshot/xlannotate/window.py:826
msgid "Height"
msgstr "Altura"

#: usr/lib/xl-screenshot/xlannotate/window.py:699
msgid "Size"
msgstr "Tamanho"

#: usr/lib/xl-screenshot/xlannotate/window.py:701
msgid "Size (not used by this tool)"
msgstr "Tamanho (não usado por esta ferramenta)"

#: usr/lib/xl-screenshot/xlannotate/window.py:784
#, python-brace-format
msgid "Font: {font}"
msgstr "Fonte: {font}"

#: usr/lib/xl-screenshot/xlannotate/window.py:788
msgid "Text Font"
