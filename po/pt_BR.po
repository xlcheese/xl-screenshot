msgstr "Sair do recorte sem alterar a imagem (Esc)"

#: usr/lib/xl-screenshot/xlannotate/window.py:502
msgid "Crop"
msgstr "Recortar"

#: usr/lib/xl-screenshot/xlannotate/window.py:504
