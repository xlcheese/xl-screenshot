#: usr/lib/xl-screenshot/xlannotate/window.py:406
msgid "Font"
msgstr "Fonte"

#: usr/lib/xl-screenshot/xlannotate/window.py:431
msgid "Open an image to annotate"
msgstr "Abra uma imagem para anotar"

#: usr/lib/xl-screenshot/xlannotate/window.py:432
msgid "Use the Open button (Ctrl+O), or paste an image with Ctrl+V."
msgstr "Use o botão Abrir (Ctrl+O) ou cole uma imagem com Ctrl+V."

#: usr/lib/xl-screenshot/xlannotate/window.py:441
msgid "Show at actual size (Ctrl+1)"
msgstr "Mostrar no tamanho real (Ctrl+1)"

#: usr/lib/xl-screenshot/xlannotate/window.py:443
msgid "Zoom out (Ctrl+−, or Ctrl+scroll)"
msgstr "Diminuir zoom (Ctrl+− ou Ctrl+rolagem)"

#: usr/lib/xl-screenshot/xlannotate/window.py:445
msgid "Zoom in (Ctrl++, or Ctrl+scroll)"
msgstr "Aumentar zoom (Ctrl++ ou Ctrl+rolagem)"

#: usr/lib/xl-screenshot/xlannotate/window.py:447
msgid "Fit the window (Ctrl+0)"
msgstr "Ajustar à janela (Ctrl+0)"

#: usr/lib/xl-screenshot/xlannotate/window.py:469
msgid ""
"Drag the area to keep. Adjust it with the handles, or drag it to move it."
msgstr ""
"Arraste a área que deseja manter. Ajuste-a pelas alças ou arraste-a para "
"movê-la."

#: usr/lib/xl-screenshot/xlannotate/window.py:479
