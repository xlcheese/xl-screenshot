msgstr "Выход"

#: usr/lib/xl-screenshot/xlscreenshot/tray.py:143
msgid "Keep xl-Screenshot in the system tray"
msgstr "Держать xl-Screenshot в системном трее"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:76
msgid "Save As…"
msgstr "Сохранить как…"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:83
msgid "Copy to Clipboard"
msgstr "Копировать в буфер обмена"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:89
