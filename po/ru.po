msgstr "_Не сейчас"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:360
msgid "_Show in Tray"
msgstr "_Показывать в трее"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:504
msgid "Window capture needs xdotool"
msgstr "Для снимка окна нужен xdotool"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:505
msgid "Install it with: sudo apt install xdotool"
msgstr "Установите его командой: sudo apt install xdotool"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:545
msgid "Window capture needs xwininfo"
msgstr "Для снимка окна нужен xwininfo"

#: usr/lib/xl-screenshot/xlscreenshot/window.py:546
msgid "Install it with: sudo apt install x11-utils"
msgstr "Установите его командой: sudo apt install x11-utils"

