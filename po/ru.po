#. name
#: usr/lib/xl-screenshot/xlannotate/window.py:1116
#, python-brace-format
msgid "{name}-annotated"
msgstr "{name}-с-пометками"

#. Translators: the start of a new annotated image's file name (date and time
#. follow)
#: usr/lib/xl-screenshot/xlannotate/window.py:1120
msgid "Annotated"
msgstr "С-пометками"

#: usr/lib/xl-screenshot/xlannotate/window.py:1176
msgid "Keep your annotations?"
msgstr "Сохранить ваши пометки?"

#: usr/lib/xl-screenshot/xlannotate/window.py:1177
msgid "Keep updates the screenshot. Discard throws these changes away."
msgstr "«Оставить» обновит снимок экрана. «Отбросить» удалит эти изменения."

#: usr/lib/xl-screenshot/xlannotate/window.py:1178
msgid "_Discard"
msgstr "О_тбросить"

#: usr/lib/xl-screenshot/xlannotate/window.py:1179
msgid "_Keep"
msgstr "О_ставить"

#: usr/lib/xl-screenshot/xlannotate/window.py:1181
#, python-brace-format
msgid "Save changes to “{name}”?"
msgstr "Сохранить изменения в «{name}»?"

#: usr/lib/xl-screenshot/xlannotate/window.py:1182
msgid "If you don't save, your annotations will be lost."
msgstr "Если не сохранить, пометки будут потеряны."

#: usr/lib/xl-screenshot/xlannotate/window.py:1183
msgid "_Don't Save"
msgstr "_Не сохранять"

#: usr/lib/xl-screenshot/xlannotate/window.py:1270
msgid ""
"Simple, light markup for images and screenshots: arrows, boxes and text that "
"stay editable until you save."
msgstr ""
"Простые и лёгкие пометки на изображениях и снимках экрана: стрелки, рамки и "
"текст, которые можно править до сохранения."

#: usr/lib/xl-screenshot/xlscreenshot/application.py:37
msgid "Start a Selection capture right away"
msgstr "Сразу начать снимок выделенной области"

#: usr/lib/xl-screenshot/xlscreenshot/application.py:40
msgid "Start with just the tray icon (used when logging in)"
